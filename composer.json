{
    "name": "shaik/laravel-dynamodb",
    "description": "A fluent DynamoDB query builder and Eloquent-like model layer for Laravel.",
    "keywords": [
        "aws",
        "dynamodb",
        "laravel",
        "orm",
        "query-builder"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Shaik Obydullah",
            "email": "sk.obydullah@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "aws/aws-sdk-php": "^3.300",
        "illuminate/container": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Shaik\\LaravelDynamoDb\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Shaik\\LaravelDynamoDb\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Shaik\\LaravelDynamoDb\\DynamoDbServiceProvider"
            ],
            "aliases": {
                "DynamoDb": "Shaik\\LaravelDynamoDb\\Facades\\DynamoDb"
            }
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
